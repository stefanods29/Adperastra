{
  "productName": "Adperastra",
  "version": "0.1.0-preview.1",
  "identifier": "app.adperastra.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Adperastra",
        "width": 1200,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://adpfile.localhost; media-src 'self' blob: http://adpfile.localhost; font-src 'self' data: http://adpfile.localhost; connect-src 'self' ipc: http://ipc.localhost http://adpfile.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../src-tauri/isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../help": "help",
      "../templates": "templates"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../installer/adperastra-hooks.nsh",
        "languages": ["English", "Spanish"]
      }
    },
    "icon": ["icons/icon.ico"]
  }
}

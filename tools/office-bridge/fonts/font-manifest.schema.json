{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adperastra.local/schemas/office-font-manifest-1.json",
  "title": "Adperastra Office pack font manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "family",
          "style",
          "weight",
          "italic",
          "byte_len",
          "sha256",
          "license",
          "license_file"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^fonts/(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:]+\\.[Tt][Tt][Ff]$"
          },
          "family": { "type": "string", "minLength": 1, "maxLength": 128 },
          "style": { "type": "string", "maxLength": 64 },
          "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "italic": { "type": "boolean" },
          "byte_len": { "type": "integer", "minimum": 1, "maximum": 67108864 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "license": {
            "enum": ["SIL-OFL-1.1", "Apache-2.0", "MIT", "BSD-2-Clause", "BSD-3-Clause"]
          },
          "license_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:]+$"
          }
        }
      }
    }
  }
}
